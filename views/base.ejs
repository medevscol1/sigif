<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="UTF-8">
  <title>SIGIF</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="/static/css/style1.css?v=10">
</head>

<body>

  <aside class="sidebar">
    <div class="logo">
      <img src="/static/img/logologin.png" alt="">
    </div>
    <div class="user-Info" style="padding-bottom: 0;">
      <!-- Usuario removido de aquí para colocarlo a la derecha -->
    </div>
    <nav class="menu">
      <ul>
        <% 
          const currentPath = (typeof request !== 'undefined' && request.path) ? request.path : '';
          const isDashboard = currentPath === '/' || currentPath === '/inicio' || currentPath === '/inicio/' || currentPath === '/dashboard' || currentPath === '/dashboard/' ? 'active' : '';
          const isActive = (p) => currentPath === p || currentPath.startsWith(p + '/') ? 'active' : '';
        %>
        <li><a href="/inicio" class="menu-dashboard <%= isDashboard %>"><i class="bi bi-speedometer2" aria-hidden="true"></i>Dashboard</a></li>
        <li><a href="/usuarios" class="menu-usuarios <%= isActive('/usuarios') || isActive('/crear_usuarios') || isActive('/editar_usuarios') %>"><i class="bi bi-people" aria-hidden="true"></i>Usuarios</a></li>
        <li><a href="/productos" class="menu-productos <%= isActive('/productos') %>"><i class="bi bi-box-seam" aria-hidden="true"></i>Productos</a></li>
        <li><a href="/inventario" class="menu-inventario <%= isActive('/inventario') %>"><i class="bi bi-boxes" aria-hidden="true"></i>Inventario</a></li>
        <li><a href="/facturacion" class="menu-facturacion <%= isActive('/facturacion') %>"><i class="bi bi-receipt" aria-hidden="true"></i>Facturación</a></li>
        <li><a href="/finanzas" class="menu-finanzas <%= isActive('/finanzas') %>"><i class="bi bi-cash-stack" aria-hidden="true"></i>Finanzas</a></li>
        <li><a href="/auditoria" class="menu-auditoria <%= isActive('/auditoria') %>"><i class="bi bi-clipboard-check" aria-hidden="true"></i>Auditoría</a></li>
        <li><a href="/configuracion" class="menu-configuracion <%= isActive('/configuracion') %>"><i class="bi bi-gear" aria-hidden="true"></i>Configuración</a></li>
      </ul>
    </nav>
    <div class="Cerrar-sesion">
      <li> <a href="/logout" class="btn-logout" onclick="return confirm('¿Estás seguro de que quieres cerrar sesión?')">Cerrar sesión</a></li>
    </div>
  </aside>

<div class="main-container">
    <div class="user-header-wrapper">
        <div class="user-menu-container position-relative">
            <button class="user-profile-card" id="userMenuButton" type="button" onclick="toggleUserMenu()" aria-expanded="false">
                <div class="user-avatar">
                    <%= (typeof request !== 'undefined' && request.session && request.session.logueado && request.session.logueado.nombre) ? request.session.logueado.nombre.charAt(0).toUpperCase() : 'U' %>
                </div>
                <div class="user-info-container">
                    <span class="user-name"><%= (typeof request !== 'undefined' && request.session && request.session.logueado && request.session.logueado.nombre) ? request.session.logueado.nombre : 'Usuario Activo' %></span>
                    <span class="user-role">
                        <%= (typeof request !== 'undefined' && request.session && request.session.logueado && request.session.logueado.rol) ? request.session.logueado.rol : 'Operador' %>
                    </span>
                </div>
                <i class="bi bi-chevron-down user-chevron"></i>
            </button>
            <div class="user-dropdown-menu" id="userDropdownMenu">
                <div class="user-dropdown-header">
                    <p class="user-dropdown-name"><%= (typeof request !== 'undefined' && request.session && request.session.logueado && request.session.logueado.nombre) ? request.session.logueado.nombre : 'Usuario Activo' %></p>
                    <span class="user-dropdown-badge"><%= (typeof request !== 'undefined' && request.session && request.session.logueado && request.session.logueado.rol) ? request.session.logueado.rol : 'Operador' %></span>
                </div>
                <div class="user-dropdown-divider"></div>
                <% if (typeof request !== 'undefined' && request.session && request.session.logueado && request.session.logueado.id) { %>
                <a href="/editar_usuarios/<%= request.session.logueado.id %>" class="user-dropdown-item">
                    <i class="bi bi-person-gear"></i>
                    <span>Editar perfil</span>
                </a>
                <% } else { %>
                <a href="/usuarios" class="user-dropdown-item">
                    <i class="bi bi-person-gear"></i>
                    <span>Editar perfil</span>
                </a>
                <% } %>
                <div class="user-dropdown-divider"></div>
                <a href="/logout" class="user-dropdown-item logout" onclick="return confirm('¿Estás seguro de que quieres cerrar sesión?')">
                    <i class="bi bi-box-arrow-right"></i>
                    <span>Cerrar sesión</span>
                </a>
            </div>
        </div>
    </div>
    
    <% 
      const globalMessages = (typeof messages !== 'undefined' && messages.length) ? messages : (typeof request !== 'undefined' && request.session && request.session.messages ? request.session.messages : []);
    %>
    <% if (globalMessages && globalMessages.length) { %>
      <div class="messages-container">
        <% globalMessages.forEach(function(m){ const tags = m.tags || m.type || 'info'; %>
          <div class="alert <%= tags.includes('error') ? 'alert-danger' : tags.includes('success') ? 'alert-success' : 'alert-info' %> alert-dismissible fade show" role="alert">
            <%= m.text || m.message || m %>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
          </div>
        <% }) %>
      </div>
    <% } %>

    <%- body %>
  </div>

  <!-- Modal global de confirmación de eliminación -->
  <div class="modal fade" id="confirmDeleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title">Confirmar eliminación</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <p id="confirmDeleteText">¿Estás seguro de que deseas eliminar este elemento?</p>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
          <button type="button" id="confirmDeleteBtn" class="btn-delete">Eliminar</button>
        </div>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    function toggleUserMenu() {
        const menu = document.getElementById('userDropdownMenu');
        const button = document.getElementById('userMenuButton');
        if (menu) {
            const isShown = menu.classList.toggle('show');
            if (button) {
                button.setAttribute('aria-expanded', isShown ? 'true' : 'false');
            }
        }
    }

    window.addEventListener('click', function(e) {
        const container = document.querySelector('.user-menu-container');
        const menu = document.getElementById('userDropdownMenu');
        const button = document.getElementById('userMenuButton');
        
        if (container && menu && !container.contains(e.target)) {
            menu.classList.remove('show');
            if (button) {
                button.setAttribute('aria-expanded', 'false');
            }
        }
    });
    (function(){
      let formToSubmit = null;
      const modalEl = document.getElementById('confirmDeleteModal');
      if(!modalEl) return;
      const bsModal = new bootstrap.Modal(modalEl);
      document.querySelectorAll('.btn-delete-trigger').forEach(btn => {
        btn.addEventListener('click', function(e){
          e.preventDefault();
          const selector = this.dataset.form;
          const name = this.dataset.name || '';
          formToSubmit = document.querySelector(selector);
          const text = name ? `¿Eliminar "${name}"? Esta acción no se puede deshacer.` : '¿Eliminar este elemento? Esta acción no se puede deshacer.';
          document.getElementById('confirmDeleteText').innerText = text;
          bsModal.show();
        });
      });
      document.getElementById('confirmDeleteBtn').addEventListener('click', function(){
        if(formToSubmit){
          formToSubmit.submit();
        }
      });
    })();
  </script>

</body>

</html>
