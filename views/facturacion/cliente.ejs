<%- include('../partials/header') %>

<div class="billing-page-container">

  <div class="billing-page-header">
    <h1 class="billing-title">Gestión de facturación</h1>
  </div>

  <div class="billing-tabs-nav">
    <a href="/facturacion" class="tab-nav-item">Facturas de salidas</a>
    <a href="/facturas" class="tab-nav-item">Facturas de entradas</a>
    <a href="/facturacion/entradas" class="tab-nav-item">Registro de entradas</a>
    <a href="/facturacion/cliente" class="tab-nav-item active">Clientes</a>
    <a href="/facturacion/productos" class="tab-nav-item">Productos</a>
  </div>

  <div class="billing-main-card">
    <div class="billing-card-header">
      <div class="header-left">
        <h2 class="card-main-title">Directorio de Clientes</h2>
        <p class="card-subtitle">Clientes registrados para emisión de facturas</p>
      </div>
      <div class="header-right">
        <a href="/facturacion" class="btn btn-outline-secondary btn-sm" style="border-radius: 8px;">
          <i class="bi bi-arrow-left"></i> Volver a Facturas
        </a>
      </div>
    </div>

    <% if (typeof clientes !== 'undefined' && clientes.length > 0) { %>
      <div class="table-responsive">
        <table class="table table-hover align-middle">
          <thead class="table-light">
            <tr>
              <th>Nombre</th>
              <th>Correo Electrónico</th>
              <th>Acciones</th>
            </tr>
          </thead>
          <tbody>
            <% clientes.forEach(function(c) { %>
              <tr>
                <td><strong><%= c.nombre %></strong></td>
                <td><%= c.correo %></td>
                <td>
                  <span class="badge bg-success-subtle text-success">Activo</span>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <div class="text-center py-5 text-muted">
        <i class="bi bi-people" style="font-size: 40px; color: #cbd5e1; display: block; margin-bottom: 10px;"></i>
        <p>Los clientes se registran automáticamente al crear facturas.</p>
        <a href="/facturacion" class="btn btn-sm btn-success mt-2" style="background-color: #15803d; border: none;">Ir a Facturación</a>
      </div>
    <% } %>
  </div>

</div>

<%- include('../partials/footer') %>
