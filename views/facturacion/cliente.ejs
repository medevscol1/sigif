<%- include('../partials/header') %>

<section class="facturacion-page clientes-facturacion-page">
  <header class="dashboard-header">
    <h1>Gestión de facturación</h1>
    <p>Clientes registrados y su historial de facturación</p>
  </header>
  <nav class="menu-horizontal facturacion-tabs" aria-label="Secciones de facturación">
    <a href="/facturacion">Facturas de salidas</a>
    <a href="/facturas">Facturas de entradas</a>
    <a href="/facturacion/entradas">Registro de entradas</a>
    <a class="active" href="/facturacion/cliente">Clientes</a>
    <a href="/facturacion/productos">Productos</a>
  </nav>

  <div class="facturas-panel clientes-panel">
    <div class="facturas-toolbar">
      <div><h2>Clientes registrados</h2><p>Listado de clientes y su historial de facturación</p></div>
      <div class="facturas-actions">
        <label class="facturas-search"><i class="bi bi-search" aria-hidden="true"></i><input id="buscarCliente" type="search" placeholder="Buscar por nombre, correo" aria-label="Buscar cliente"></label>
        <span class="facturas-count"><i class="bi bi-people"></i> <%= clientesFacturacion.length %> clientes</span>
      </div>
    </div>
    <div class="clientes-facturacion-grid">
      <% if (clientesFacturacion.length) { %>
        <% clientesFacturacion.forEach(function(item, index) { const cliente = item.cliente; const inicial = (cliente.nombre || 'C').charAt(0).toUpperCase(); %>
          <article class="cliente-facturacion-card" data-search="<%= (cliente.nombre + ' ' + cliente.correo).toLowerCase() %>">
            <div class="cliente-card-top"><div class="cliente-avatar"><%= inicial %></div><div class="cliente-heading"><span>Cliente #<%= index + 1 %></span><strong><%= cliente.nombre %></strong></div><div class="cliente-compras"><span>Total compras</span><strong><%= formatoPrecio(item.totalCompras) %></strong></div></div>
            <div class="cliente-meta"><div><span><i class="bi bi-envelope"></i> Correo</span><strong><%= cliente.correo %></strong></div><div><span><i class="bi bi-calendar3"></i> Última compra</span><strong><%= item.ultimaCompra ? dateFormat(item.ultimaCompra.fecha, 'es-CO', { day: '2-digit', month: '2-digit', year: 'numeric' }) : 'Sin compras' %></strong></div></div>
            <div class="cliente-historial"><span>Historial de facturas</span>
              <% if (item.facturas.length) { %>
                <% item.facturas.slice(0, 3).forEach(function(factura) { const numero = factura.numero || factura.codigo || String(factura._id).slice(-6).toUpperCase(); %>
                  <a class="cliente-factura-row" href="/facturacion/factura/<%= factura._id %>" target="_blank" rel="noopener"><span><i class="bi bi-receipt"></i> Factura #<%= numero %><small><%= dateFormat(factura.fecha, 'es-CO', { day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %></small></span><strong><%= formatoPrecio(factura.total) %></strong></a>
                <% }) %>
              <% } else { %><div class="cliente-sin-facturas">No hay facturas registradas</div><% } %>
            </div>
          </article>
        <% }) %>
      <% } else { %>
        <div class="facturas-empty"><i class="bi bi-people"></i><strong>No hay clientes registrados</strong><span>Los clientes aparecerán aquí cuando se registren.</span></div>
      <% } %>
    </div>
    <p id="sinResultadosClientes" class="facturas-no-results" hidden>No se encontraron clientes con ese criterio.</p>
  </div>
</section>

<script>
  const buscadorCliente = document.getElementById('buscarCliente');
  const tarjetasCliente = Array.from(document.querySelectorAll('.cliente-facturacion-card'));
  const sinResultadosClientes = document.getElementById('sinResultadosClientes');
  if (buscadorCliente) buscadorCliente.addEventListener('input', function () {
    const termino = this.value.trim().toLowerCase(); let visibles = 0;
    tarjetasCliente.forEach(function (tarjeta) { const coincide = tarjeta.dataset.search.includes(termino); tarjeta.hidden = !coincide; if (coincide) visibles += 1; });
    if (sinResultadosClientes) sinResultadosClientes.hidden = visibles !== 0 || tarjetasCliente.length === 0;
  });
</script>

<%- include('../partials/footer') %>
