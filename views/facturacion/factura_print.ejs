<!DOCTYPE html>
<html lang="es"><head><meta charset="UTF-8"><title>Factura <%= factura.numero || factura.codigo || factura._id %> | SIGIF</title>
<style>body{font-family:Arial,sans-serif;color:#182235;max-width:760px;margin:40px auto;padding:0 24px}header{display:flex;justify-content:space-between;border-bottom:2px solid #1b9563;padding-bottom:20px}h1{margin:0;font-size:24px}p{color:#64748b}.total{color:#087f55;font-size:24px;font-weight:700}.details{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin:30px 0}.label{display:block;color:#64748b;font-size:12px;text-transform:uppercase;margin-bottom:5px}.print{background:#087f55;color:white;border:0;padding:11px 18px;cursor:pointer;border-radius:5px}@media print{.print{display:none}body{margin:0}}</style></head>
<body><header><div><h1>SIGIF</h1><p>Factura #<%= factura.numero || factura.codigo || factura._id %></p></div><div class="total"><%= formatoPrecio(factura.total) %></div></header>
<div class="details"><div><span class="label">Cliente</span><strong><%= factura.cliente && factura.cliente.nombre || 'Cliente no registrado' %></strong></div><div><span class="label">Correo</span><strong><%= factura.cliente && factura.cliente.correo || 'Sin correo' %></strong></div><div><span class="label">Fecha</span><strong><%= dateFormat(factura.fecha, 'es-CO') %></strong></div><div><span class="label">Vendedor</span><strong><%= factura.vendedor || 'Sistema' %></strong></div></div><button class="print" onclick="window.print()">Imprimir o guardar como PDF</button></body></html>