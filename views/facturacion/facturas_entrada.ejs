<%- include('../partials/header') %>

<div class="billing-page-container">

  <div class="billing-page-header">
    <h1 class="billing-title">Gestión de facturación</h1>
  </div>

  <div class="billing-tabs-nav">
    <a href="/facturacion" class="tab-nav-item">Facturas de salidas</a>
    <a href="/facturas" class="tab-nav-item active">Facturas de entradas</a>
    <a href="/facturacion/entradas" class="tab-nav-item">Registro de entradas</a>
    <a href="/facturacion/cliente" class="tab-nav-item">Clientes</a>
    <a href="/facturacion/productos" class="tab-nav-item">Productos</a>
  </div>

  <div class="billing-main-card">
    <div class="billing-card-header">
      <div class="header-left">
        <h2 class="card-main-title">Facturas de entradas</h2>
        <p class="card-subtitle">Listado de compras e ingresos de mercancía a proveedores</p>
      </div>
      <div class="header-right">
        <a href="/facturacion/entradas" class="btn-create-invoice">
          <i class="bi bi-plus-circle"></i>
          <span>Registrar Entrada</span>
        </a>
      </div>
    </div>

    <% if (typeof facturas !== 'undefined' && facturas.length > 0) { %>
      <div class="table-responsive">
        <table class="table table-hover align-middle">
          <thead class="table-light">
            <tr>
              <th># Factura</th>
              <th>Fecha</th>
              <th>Proveedor</th>
              <th>Productos</th>
              <th>Total</th>
              <th>Acciones</th>
            </tr>
          </thead>
          <tbody>
            <% facturas.forEach(function(f) { %>
              <tr>
                <td><strong>#<%= f.numero %></strong></td>
                <td><%= new Date(f.fecha).toLocaleDateString() %></td>
                <td><%= (f.cliente && f.cliente.nombre) ? f.cliente.nombre : 'Proveedor' %></td>
                <td><%= f.productos ? f.productos.length : 0 %> productos</td>
                <td><strong class="text-success">$<%= Number(f.total).toLocaleString('en-US') %></strong></td>
                <td>
                  <a href="/facturacion/pdf/<%= f._id %>" target="_blank" class="btn btn-sm btn-outline-success">
                    <i class="bi bi-file-pdf"></i> Ver
                  </a>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <div class="text-center py-5 text-muted">
        <i class="bi bi-inbox" style="font-size: 40px; color: #cbd5e1; display: block; margin-bottom: 10px;"></i>
        <p>No hay facturas de entrada registradas actualmente.</p>
        <a href="/facturacion/entradas" class="btn btn-sm btn-outline-primary mt-2">Registrar primera entrada</a>
      </div>
    <% } %>
  </div>

</div>

<%- include('../partials/footer') %>
