<%- include('../partials/header') %>

<div class="billing-page-container">

  <div class="billing-page-header">
    <h1 class="billing-title">Gestión de facturación</h1>
  </div>

  <div class="billing-tabs-nav">
    <a href="/facturacion" class="tab-nav-item">Facturas de salidas</a>
    <a href="/facturas" class="tab-nav-item">Facturas de entradas</a>
    <a href="/facturacion/entradas" class="tab-nav-item">Registro de entradas</a>
    <a href="/facturacion/cliente" class="tab-nav-item">Clientes</a>
    <a href="/facturacion/productos" class="tab-nav-item active">Productos</a>
  </div>

  <div class="billing-main-card">
    <div class="billing-card-header">
      <div class="header-left">
        <h2 class="card-main-title">Catálogo para Facturación</h2>
        <p class="card-subtitle">Productos disponibles con stock activo para venta</p>
      </div>
      <div class="header-right">
        <a href="/productos/crear" class="btn-create-invoice" style="text-decoration: none;">
          <i class="bi bi-plus-circle"></i>
          <span>Nuevo Producto</span>
        </a>
      </div>
    </div>

    <% if (typeof productos !== 'undefined' && productos.length > 0) { %>
      <div class="table-responsive">
        <table class="table table-hover align-middle">
          <thead class="table-light">
            <tr>
              <th>Producto</th>
              <th>Categoría</th>
              <th>Precio Unitario</th>
              <th>Stock</th>
              <th>Estado</th>
            </tr>
          </thead>
          <tbody>
            <% productos.forEach(function(p) { %>
              <tr>
                <td><strong><%= p.nombre %></strong></td>
                <td><span class="badge bg-light text-dark"><%= p.categoria || 'General' %></span></td>
                <td><strong class="text-success">$<%= Number(p.precio).toLocaleString('en-US') %></strong></td>
                <td><%= p.stock %> unidades</td>
                <td><span class="badge bg-success">Disponible</span></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <div class="text-center py-5 text-muted">
        <i class="bi bi-box" style="font-size: 40px; color: #cbd5e1; display: block; margin-bottom: 10px;"></i>
        <p>No hay productos registrados aún en el catálogo.</p>
        <a href="/productos/crear" class="btn btn-sm btn-success mt-2" style="background-color: #15803d; border: none;">Crear Producto</a>
      </div>
    <% } %>
  </div>

</div>

<%- include('../partials/footer') %>
