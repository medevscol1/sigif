<%- include('../partials/header') %>


<section class="facturacion-page productos-facturacion-page">
  <header class="dashboard-header">
    <h1>Gestión de facturación</h1>
    <p>Productos vendidos y resumen de sus ventas</p>
  </header>
  <nav class="menu-horizontal facturacion-tabs" aria-label="Secciones de facturación">
    <a href="/facturacion">Facturas de salidas</a>
    <a href="/facturas">Facturas de entradas</a>
    <a href="/facturacion/entradas">Registro de entradas</a>
    <a href="/facturacion/cliente">Clientes</a>
    <a class="active" href="/facturacion/productos">Productos</a>
  </nav>

  <div class="facturas-panel productos-vendidos-panel">
    <div class="facturas-toolbar">
      <div><h2>Productos vendidos</h2><p>Cada producto con el resumen de sus ventas. Abre los movimientos para ver el detalle.</p></div>
      <span class="facturas-count"><i class="bi bi-box-seam"></i> <%= productosVendidos.length %> productos</span>
    </div>
    <div class="productos-vendidos-grid">
      <% if (productosVendidos.length) { %>
        <% productosVendidos.forEach(function(item, index) { const producto = item.producto; const ultimo = item.movimientos[0]; %>
          <article class="producto-vendido-card">
            <div class="producto-vendido-top">
              <div class="producto-vendido-icon"><i class="bi bi-box-seam"></i></div>
              <div class="producto-vendido-heading"><span>Producto</span><strong title="<%= producto.nombre %>"><%= producto.nombre %></strong></div>
              <div class="producto-ingresos"><span>Ingresos</span><strong><%= formatoPrecio(item.ingresos) %></strong></div>
            </div>
            <div class="producto-vendido-stats">
              <div><span><i class="bi bi-hash"></i> Ventas</span><strong><%= item.ventas %> movimientos</strong></div>
              <div><span><i class="bi bi-box-seam"></i> Unidades</span><strong>x<%= item.unidades %></strong></div>
            </div>
            <div class="producto-ultima-venta"><span><i class="bi bi-clock-history"></i> Última venta</span><div><strong>Movimiento #<%= ultimo.id %></strong><small><%= dateFormat(ultimo.fecha, 'es-CO', { day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %></small></div></div>
            <button type="button" class="producto-movimientos-btn" data-producto-index="<%= index %>"><i class="bi bi-list-ul"></i> Ver movimientos</button>
            <div class="movimientos-data" hidden>
              <% item.movimientos.forEach(function(movimiento) { %><div><span>Movimiento #<%= movimiento.id %></span><span><%= dateFormat(movimiento.fecha, 'es-CO', { day: '2-digit', month: '2-digit', year: 'numeric' }) %></span><strong>x<%= movimiento.cantidad %> · <%= formatoPrecio(movimiento.total) %></strong></div><% }) %>
            </div>
          </article>
        <% }) %>
      <% } else { %>
        <div class="facturas-empty"><i class="bi bi-box-seam"></i><strong>No hay productos vendidos todavía</strong><span>Los productos aparecerán aquí después de registrar una venta.</span><a href="/inventario">Ir al catálogo de ventas</a></div>
      <% } %>
    </div>
  </div>
 </section>

<div class="movimientos-modal" id="movimientosModal" hidden><div class="movimientos-dialog"><div class="movimientos-dialog-header"><h3>Movimientos del producto</h3><button type="button" id="cerrarMovimientos" aria-label="Cerrar"><i class="bi bi-x-lg"></i></button></div><div id="movimientosContenido"></div></div></div>
<script>
  const modalMovimientos = document.getElementById('movimientosModal');
  const contenidoMovimientos = document.getElementById('movimientosContenido');
  document.querySelectorAll('.producto-movimientos-btn').forEach(function (button) {
    button.addEventListener('click', function () {
      contenidoMovimientos.innerHTML = this.parentElement.querySelector('.movimientos-data').innerHTML;
      modalMovimientos.hidden = false;
    });
  });
  document.getElementById('cerrarMovimientos').addEventListener('click', function () { modalMovimientos.hidden = true; });
  modalMovimientos.addEventListener('click', function (event) { if (event.target === modalMovimientos) modalMovimientos.hidden = true; });
</script>

<%- include('../partials/footer') %>
