<%- include('../partials/header') %>


<section class="facturacion-page registro-entradas-page">
  <header class="dashboard-header">
    <h1>Gestión de facturación</h1>
    <p>Registro detallado de los productos ingresados al inventario</p>
  </header>
  <nav class="menu-horizontal facturacion-tabs" aria-label="Secciones de facturación">
    <a href="/facturacion">Facturas de salidas</a>
    <a href="/facturas">Facturas de entradas</a>
    <a class="active" href="/facturacion/entradas">Registro de entradas</a>
    <a href="/facturacion/cliente">Clientes</a>
    <a href="/facturacion/productos">Productos</a>
  </nav>
  <div class="facturas-panel registro-panel">
    <div class="facturas-toolbar">
      <div><h2>Registro de entradas</h2><p>Detalle línea por línea de todos los productos ingresados al inventario</p></div>
      <div class="facturas-actions">
        <label class="facturas-search"><i class="bi bi-search"></i><input id="buscarRegistro" type="search" placeholder="Buscar por producto, factura" aria-label="Buscar registro"></label>
        <span class="facturas-count"><i class="bi bi-list-ul"></i> <%= registrosEntradas.length %> registros</span>
      </div>
    </div>
    <% if (request.query.error) { %><div class="alert alert-warning">Completa todos los campos de la entrada antes de guardar.</div><% } %>
    <div class="registro-form-wrap"><details><summary><i class="bi bi-plus-circle"></i> Registrar nueva entrada</summary><form class="registro-form" method="post" action="/facturacion/entradas"><label>Factura / documento<input name="numero" required placeholder="ENT-00001"></label><label>Proveedor<input name="proveedor" required placeholder="Nombre del proveedor"></label><label>Registró<input name="registro" placeholder="Usuario responsable"></label><label>Fecha<input name="fecha" type="datetime-local"></label><label>Producto<select name="producto" required><option value="">Selecciona un producto</option><% productos.forEach(function(producto) { %><option value="<%= producto._id %>"><%= producto.nombre %></option><% }) %></select></label><label>Cantidad<input name="cantidad" type="number" min="1" required></label><label>Precio unitario<input name="precio" type="number" min="0" step="0.01" required></label><button type="submit"><i class="bi bi-save"></i> Guardar entrada</button></form></details></div>
    <div class="registro-table-wrap"><table class="registro-table"><thead><tr><th>Factura</th><th>Fecha</th><th>Producto</th><th>Proveedor</th><th>Cantidad</th><th>Precio unit.</th><th>Subtotal</th><th></th></tr></thead><tbody id="registrosBody"><% if (registrosEntradas.length) { %><% registrosEntradas.forEach(function(item) { %><tr data-search="<%= (item.entrada.numero + ' ' + item.entrada.proveedor + ' ' + (item.producto ? item.producto.nombre : '')).toLowerCase() %>"><td><strong><%= item.entrada.numero %></strong></td><td><%= dateFormat(item.entrada.fecha, 'es-CO', { day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %></td><td><i class="bi bi-box"></i> <%= item.producto ? item.producto.nombre : 'Producto eliminado' %></td><td><%= item.entrada.proveedor %></td><td><b class="cantidad-pill">+<%= item.cantidad %></b></td><td><%= formatoPrecio(item.precio) %></td><td><strong><%= formatoPrecio(item.subtotal) %></strong></td><td><button type="button" class="registro-download" onclick="window.print()" aria-label="Imprimir registro"><i class="bi bi-download"></i></button></td></tr><% }) %><% } else { %><tr><td colspan="8" class="registro-vacio">No hay registros de entradas.</td></tr><% } %></tbody></table></div>
  </div>
</section>

<script>
  const buscarRegistro = document.getElementById('buscarRegistro');
  if (buscarRegistro) buscarRegistro.addEventListener('input', function () {
    const q = this.value.trim().toLowerCase();
    document.querySelectorAll('#registrosBody tr[data-search]').forEach(function (fila) {
      fila.hidden = !fila.dataset.search.includes(q);
    });
  });
</script>

<%- include('../partials/footer') %>