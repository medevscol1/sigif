<%- include('../partials/header') %>

<div class="billing-page-container">

  <div class="billing-page-header">
    <h1 class="billing-title">Gestión de facturación</h1>
  </div>

  <div class="billing-tabs-nav">
    <a href="/facturacion" class="tab-nav-item">Facturas de salidas</a>
    <a href="/facturas" class="tab-nav-item">Facturas de entradas</a>
    <a href="/facturacion/entradas" class="tab-nav-item active">Registro de entradas</a>
    <a href="/facturacion/cliente" class="tab-nav-item">Clientes</a>
    <a href="/facturacion/productos" class="tab-nav-item">Productos</a>
  </div>

  <div class="billing-main-card">
    <div class="billing-card-header">
      <div class="header-left">
        <h2 class="card-main-title">Registro de entradas de inventario</h2>
        <p class="card-subtitle">Registra compras a proveedores y abastecimiento de mercancía</p>
      </div>
    </div>

    <form action="/facturacion/crear" method="POST" class="row g-3" style="max-width: 800px;">
      <input type="hidden" name="vendedor" value="medevs">
      <div class="col-md-6">
        <label class="form-label fw-bold">Proveedor / Empresa</label>
        <input type="text" name="clienteNombre" class="form-control" placeholder="Ej: Distribuidora Motopartes S.A." required>
      </div>
      <div class="col-md-6">
        <label class="form-label fw-bold">Correo del Proveedor</label>
        <input type="email" name="clienteCorreo" class="form-control" placeholder="ventas@proveedor.com" required>
      </div>
      <div class="col-md-12">
        <label class="form-label fw-bold">Producto a Ingresar</label>
        <input type="text" name="productoNombre" class="form-control" placeholder="Nombre del repuesto o artículo" required>
      </div>
      <div class="col-md-6">
        <label class="form-label fw-bold">Cantidad</label>
        <input type="number" name="cantidad" class="form-control" value="10" min="1" required>
      </div>
      <div class="col-md-6">
        <label class="form-label fw-bold">Costo Unitario ($)</label>
        <input type="number" name="precioUnitario" class="form-control" placeholder="50000" min="0" required>
      </div>
      <div class="col-12 pt-3">
        <button type="submit" class="btn btn-success" style="background-color: #15803d; border: none; padding: 10px 24px; font-weight: 600; border-radius: 8px;">
          Guardar Entrada de Mercancía
        </button>
      </div>
    </form>
  </div>

</div>

<%- include('../partials/footer') %>
