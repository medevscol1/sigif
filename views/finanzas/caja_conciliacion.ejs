<%- include('../partials/header') %>

<header class="dashboard-header">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4 pb-2 border-bottom">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-info-subtle text-info border border-info-subtle px-2 py-1 rounded-pill fw-semibold">
                    <i class="bi bi-cash-stack me-1"></i>Caja y Conciliación
                </span>
                <h2 class="h3 fw-bold text-dark mb-0">Cortes de Caja y Balance Diario</h2>
            </div>
            <p class="text-muted small mb-0">Reporte de entradas/salidas diarias, arqueo de efectivo y conciliación bancaria.</p>
        </div>
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <form method="get" class="d-flex align-items-center gap-2">
                <input type="hidden" name="periodo" value="<%= periodo %>">
                <select name="periodo" class="form-select form-select-sm shadow-none" onchange="this.form.submit()" style="max-width: 180px;">
                    <option value="hoy" <%= periodo === 'hoy' ? 'selected' : '' %>>Hoy</option>
                    <option value="semana" <%= periodo === 'semana' ? 'selected' : '' %>>Esta semana</option>
                    <option value="mes" <%= periodo === 'mes' ? 'selected' : '' %>>Este mes</option>
                    <option value="ano" <%= periodo === 'ano' ? 'selected' : '' %>>Este año</option>
                </select>
            </form>
            <button class="btn btn-outline-secondary btn-sm rounded-2 d-flex align-items-center gap-1 shadow-xs px-3 py-2" onclick="window.print()">
                <i class="bi bi-printer"></i> Imprimir
            </button>
        </div>
    </div>
</header>

<% if (typeof ingresos !== 'undefined') { %>
<div class="row g-3 mb-4">
    <div class="col-xl-3 col-md-6">
        <div class="card pg-kpi-card shadow-sm h-100 p-3 bg-white rounded-3 border border-success">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <div>
                    <span class="pg-kpi-label text-muted fw-semibold small text-uppercase">Ventas Efectivo</span>
                    <div class="pg-kpi-value text-success fw-bold fs-4 mt-1"><%= formatoPrecio(total_efectivo_ventas) %></div>
                </div>
                <div class="pg-kpi-icon bg-success-subtle text-success rounded-3 p-2">
                    <i class="bi bi-cash-coin fs-5"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="card pg-kpi-card shadow-sm h-100 p-3 bg-white rounded-3 border border-primary">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <div>
                    <span class="pg-kpi-label text-muted fw-semibold small text-uppercase">Ventas Tarjeta</span>
                    <div class="pg-kpi-value text-primary fw-bold fs-4 mt-1"><%= formatoPrecio(total_tarjeta_ventas) %></div>
                </div>
                <div class="pg-kpi-icon bg-primary-subtle text-primary rounded-3 p-2">
                    <i class="bi bi-credit-card fs-5"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="card pg-kpi-card shadow-sm h-100 p-3 bg-white rounded-3 border border-info">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <div>
                    <span class="pg-kpi-label text-muted fw-semibold small text-uppercase">Ventas Transferencia</span>
                    <div class="pg-kpi-value text-info fw-bold fs-4 mt-1"><%= formatoPrecio(total_transf_ventas) %></div>
                </div>
                <div class="pg-kpi-icon bg-info-subtle text-info rounded-3 p-2">
                    <i class="bi bi-bank fs-5"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="card pg-kpi-card shadow-sm h-100 p-3 bg-white rounded-3 border border-warning">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <div>
                    <span class="pg-kpi-label text-muted fw-semibold small text-uppercase">Ventas Crédito</span>
                    <div class="pg-kpi-value text-warning fw-bold fs-4 mt-1"><%= formatoPrecio(total_credito_ventas) %></div>
                </div>
                <div class="pg-kpi-icon bg-warning-subtle text-warning rounded-3 p-2">
                    <i class="bi bi-clock fs-5"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-xl-3 col-md-6">
        <div class="card pg-kpi-card shadow-sm h-100 p-3 bg-white rounded-3 border border-danger">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <div>
                    <span class="pg-kpi-label text-muted fw-semibold small text-uppercase">Gastos Efectivo</span>
                    <div class="pg-kpi-value text-danger fw-bold fs-4 mt-1"><%= formatoPrecio(total_gastos_efectivo) %></div>
                </div>
                <div class="pg-kpi-icon bg-danger-subtle text-danger rounded-3 p-2">
                    <i class="bi bi-cash-stack fs-5"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="card pg-kpi-card shadow-sm h-100 p-3 bg-white rounded-3 border border-secondary">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <div>
                    <span class="pg-kpi-label text-muted fw-semibold small text-uppercase">Gastos Otros</span>
                    <div class="pg-kpi-value text-secondary fw-bold fs-4 mt-1"><%= formatoPrecio(total_gastos_otros) %></div>
                </div>
                <div class="pg-kpi-icon bg-secondary-subtle text-secondary rounded-3 p-2">
                    <i class="bi bi-credit-card fs-5"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="card pg-kpi-card shadow-sm h-100 p-3 bg-white rounded-3 border border-success">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <div>
                    <span class="pg-kpi-label text-muted fw-semibold small text-uppercase">Saldo Efectivo en Caja</span>
                    <div class="pg-kpi-value text-success fw-bold fs-4 mt-1"><%= formatoPrecio(saldo_efectivo_en_caja) %></div>
                </div>
                <div class="pg-kpi-icon bg-success-subtle text-success rounded-3 p-2">
                    <i class="bi bi-wallet2 fs-5"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="card pg-kpi-card shadow-sm h-100 p-3 bg-white rounded-3 border border-primary">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <div>
                    <span class="pg-kpi-label text-muted fw-semibold small text-uppercase">Cuentas por Cobrar</span>
                    <div class="pg-kpi-value text-primary fw-bold fs-4 mt-1"><%= formatoPrecio(cuentas_pendientes) %></div>
                </div>
                <div class="pg-kpi-icon bg-primary-subtle text-primary rounded-3 p-2">
                    <i class="bi bi-people fs-5"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-3 p-4 bg-white">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-3">
        <div>
            <h3 class="h6 fw-bold text-dark mb-1">
                <i class="bi bi-calendar-check me-2"></i>Cortes Diarios de Caja
            </h3>
            <p class="text-muted small mb-0">Arqueo y balance por día del período seleccionado</p>
        </div>
        <small class="text-muted">Generado: <%= new Date().toLocaleString('es-CO') %></small>
    </div>

    <% if (config_empresa && config_empresa.nombre_comercial) { %>
    <div class="alert alert-light border mb-3 p-3">
        <div class="d-flex justify-content-between align-items-start">
            <div>
                <strong class="text-dark"><%= config_empresa.nombre_comercial %></strong>
                <br><small class="text-muted">NIT: <%= config_empresa.nit || '—' %> | Dirección: <%= config_empresa.direccion || '—' %></small>
            </div>
            <div class="text-end">
                <small class="text-muted">Reporte de Caja y Conciliación</small>
                <br><small class="text-muted"><%= inicio.toLocaleDateString('es-CO') %> - <%= fin.toLocaleDateString('es-CO') %></small>
            </div>
        </div>
    </div>
    <% } %>

    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-3 text-uppercase text-muted small fw-semibold" style="width: 130px;">Fecha</th>
                    <th class="text-center text-uppercase text-muted small fw-semibold">Ventas Efectivo</th>
                    <th class="text-center text-uppercase text-muted small fw-semibold">Ventas Tarjeta</th>
                    <th class="text-center text-uppercase text-muted small fw-semibold">Ventas Transf.</th>
                    <th class="text-center text-uppercase text-muted small fw-semibold">Ventas Crédito</th>
                    <th class="text-end text-uppercase text-muted small fw-semibold">Total Entradas</th>
                    <th class="text-center text-uppercase text-muted small fw-semibold">Gastos Efectivo</th>
                    <th class="text-center text-uppercase text-muted small fw-semibold">Gastos Otros</th>
                    <th class="text-end text-uppercase text-muted small fw-semibold">Total Salidas</th>
                    <th class="text-end text-uppercase text-muted small fw-semibold">Saldo Caja</th>
                    <th class="text-end text-uppercase text-muted small fw-semibold">Total Neto</th>
                    <th class="text-center text-uppercase text-muted small fw-semibold"># Ventas</th>
                    <th class="text-center text-uppercase text-muted small fw-semibold"># Gastos</th>
                </tr>
            </thead>
            <tbody>
                <% if (cortes_diarios && cortes_diarios.length > 0) { %>
                    <% cortes_diarios.forEach(function(c) { %>
                        <tr>
                            <td class="ps-3 fw-medium text-dark small"><%= c.fecha %></td>
                            <td class="text-center fw-semibold text-success"><%= formatoPrecio(c.ventas_efectivo) %></td>
                            <td class="text-center fw-semibold text-primary"><%= formatoPrecio(c.ventas_tarjeta) %></td>
                            <td class="text-center fw-semibold text-info"><%= formatoPrecio(c.ventas_transferencia) %></td>
                            <td class="text-center fw-semibold text-warning"><%= formatoPrecio(c.ventas_credito) %></td>
                            <td class="text-end fw-bold text-dark"><%= formatoPrecio(c.total_entradas) %></td>
                            <td class="text-center fw-semibold text-danger"><%= formatoPrecio(c.gastos_efectivo) %></td>
                            <td class="text-center fw-semibold text-secondary"><%= formatoPrecio(c.gastos_otros) %></td>
                            <td class="text-end fw-bold text-danger"><%= formatoPrecio(c.total_salidas) %></td>
                            <td class="text-end fw-bold <%= c.saldo_caja_efectivo >= 0 ? 'text-success' : 'text-danger' %>"><%= formatoPrecio(c.saldo_caja_efectivo) %></td>
                            <td class="text-end fw-bold <%= c.total_neto >= 0 ? 'text-success' : 'text-danger' %>"><%= formatoPrecio(c.total_neto) %></td>
                            <td class="text-center text-muted small"><%= c.num_ventas %></td>
                            <td class="text-center text-muted small"><%= c.num_gastos %></td>
                        </tr>
                    <% }); %>
                <% } else { %>
                    <tr>
                        <td colspan="13" class="text-center py-5 text-muted">
                            <i class="bi bi-calendar-x fs-1 d-block mb-2 text-secondary opacity-50"></i>
                            <h6 class="fw-semibold text-dark">No hay movimientos en este período</h6>
                        </td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
</div>

<% } else { %>
    <div class="alert alert-info text-center py-5">
        <i class="bi bi-cash-stack fs-1 d-block mb-2 text-secondary opacity-50"></i>
        <h5 class="fw-semibold text-dark">No hay datos para mostrar en este período</h5>
    </div>
<% } %>

<%- include('../partials/footer') %>

<style>
.pg-kpi-card { transition: transform 0.2s ease, box-shadow 0.2s ease; border-color: #e2e8f0 !important; }
.pg-kpi-card:hover { transform: translateY(-2px); box-shadow: 0 8px 20px rgba(0, 0, 0, 0.06) !important; }
.pg-kpi-label { letter-spacing: 0.03em; font-size: 0.72rem; }
.pg-kpi-icon { width: 42px; height: 42px; display: flex; align-items: center; justify-content: center; }
</style>