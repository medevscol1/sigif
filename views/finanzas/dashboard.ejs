<%- include('../partials/header') %>

<header class="dashboard-header">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4 pb-2 border-bottom">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 rounded-pill fw-semibold">
                    <i class="bi bi-graph-up-arrow me-1"></i>Estado de Resultados (P&G)
                </span>
                <h2 class="h3 fw-bold text-dark mb-0">Dashboard Financiero</h2>
            </div>
            <p class="text-muted small mb-0">Resumen consolidado de pérdidas y ganancias del período seleccionado.</p>
        </div>
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <form method="get" class="d-flex align-items-center gap-2">
                <input type="hidden" name="periodo" value="<%= periodo %>">
                <select name="periodo" class="form-select form-select-sm shadow-none" onchange="this.form.submit()" style="max-width: 180px;">
                    <option value="hoy" <%= periodo === 'hoy' ? 'selected' : '' %>>Hoy</option>
                    <option value="semana" <%= periodo === 'semana' ? 'selected' : '' %>>Esta semana</option>
                    <option value="mes" <%= periodo === 'mes' ? 'selected' : '' %>>Este mes</option>
                    <option value="ano" <%= periodo === 'ano' ? 'selected' : '' %>>Este año</option>
                    <option value="personalizado" <%= periodo === 'personalizado' ? 'selected' : '' %>>Personalizado</option>
                </select>
                <% if (periodo === 'personalizado') { %>
                    <input type="date" name="desde" value="<%= inicio ? inicio.toISOString().split('T')[0] : '' %>" class="form-control form-control-sm shadow-none" style="max-width: 150px;">
                    <input type="date" name="hasta" value="<%= fin ? fin.toISOString().split('T')[0] : '' %>" class="form-control form-control-sm shadow-none" style="max-width: 150px;">
                <% } %>
            </form>
        </div>
    </div>
</header>

<% if (typeof ingresos !== 'undefined') { %>
<div class="row g-3 mb-4">
    <div class="col-xl-3 col-md-6">
        <div class="card pg-kpi-card shadow-sm h-100 p-3 bg-white rounded-3 border border-success">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <div>
                    <span class="pg-kpi-label text-muted fw-semibold small text-uppercase">Ingresos Efectivos</span>
                    <div class="pg-kpi-value text-success fw-bold fs-4 mt-1"><%= formatoPrecio(ingresos) %></div>
                </div>
                <div class="pg-kpi-icon bg-success-subtle text-success rounded-3 p-2">
                    <i class="bi bi-cash-coin fs-5"></i>
                </div>
            </div>
            <div class="d-flex align-items-center gap-2 text-muted small pt-2 border-top">
                <i class="bi bi-arrow-down-right-circle text-success"></i>
                <span><%= ventas %> facturas pagadas</span>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="card pg-kpi-card shadow-sm h-100 p-3 bg-white rounded-3 border border-danger">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <div>
                    <span class="pg-kpi-label text-muted fw-semibold small text-uppercase">Costos (COGS)</span>
                    <div class="pg-kpi-value text-danger fw-bold fs-4 mt-1"><%= formatoPrecio(costos) %></div>
                </div>
                <div class="pg-kpi-icon bg-danger-subtle text-danger rounded-3 p-2">
                    <i class="bi bi-box-seam fs-5"></i>
                </div>
            </div>
            <div class="d-flex align-items-center gap-2 text-muted small pt-2 border-top">
                <i class="bi bi-truck text-danger"></i>
                <span>Costo de mercancía vendida</span>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="card pg-kpi-card shadow-sm h-100 p-3 bg-white rounded-3 border border-warning">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <div>
                    <span class="pg-kpi-label text-muted fw-semibold small text-uppercase">Gastos Operativos</span>
                    <div class="pg-kpi-value text-warning fw-bold fs-4 mt-1"><%= formatoPrecio(gastos_total) %></div>
                </div>
                <div class="pg-kpi-icon bg-warning-subtle text-warning rounded-3 p-2">
                    <i class="bi bi-receipt-cutoff fs-5"></i>
                </div>
            </div>
            <div class="d-flex align-items-center gap-2 text-muted small pt-2 border-top">
                <i class="bi bi-credit-card text-warning"></i>
                <span><%= gastos.count %> egresos registrados</span>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="card pg-kpi-card shadow-sm h-100 p-3 bg-white rounded-3 border <%= utilidad_neta >= 0 ? 'border-success' : 'border-danger' %>">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <div>
                    <span class="pg-kpi-label text-muted fw-semibold small text-uppercase">Utilidad Neta</span>
                    <div class="pg-kpi-value <%= utilidad_neta >= 0 ? 'text-success' : 'text-danger' %> fw-bold fs-4 mt-1"><%= formatoPrecio(utilidad_neta) %></div>
                </div>
                <div class="pg-kpi-icon <%= utilidad_neta >= 0 ? 'bg-success-subtle text-success' : 'bg-danger-subtle text-danger' %> rounded-3 p-2">
                    <i class="bi bi-graph-up <%= utilidad_neta >= 0 ? 'text-success' : 'text-danger' %> fs-5"></i>
                </div>
            </div>
            <div class="d-flex align-items-center gap-2 text-muted small pt-2 border-top">
                <i class="bi bi-percent <%= utilidad_neta >= 0 ? 'text-success' : 'text-danger' %>"></i>
                <span>Margen neto: <%= margen.toFixed(1) %>%</span>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm rounded-3 p-4 h-100 bg-white">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h3 class="h6 fw-bold text-dark mb-1">
                        <i class="bi bi-bar-chart-fill text-success me-2"></i>Desglose P&G
                    </h3>
                    <p class="text-muted small mb-0">Composición de la utilidad neta</p>
                </div>
            </div>
            <div class="chart-container position-relative" style="height: 280px;">
                <canvas id="chartPnG"></canvas>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card border-0 shadow-sm rounded-3 p-4 h-100 bg-white">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h3 class="h6 fw-bold text-dark mb-1">
                        <i class="bi bi-pie-chart-fill text-info me-2"></i>Estructura de Costos
                    </h3>
                    <p class="text-muted small mb-0">Distribución porcentual</p>
                </div>
            </div>
            <div class="chart-container position-relative d-flex align-items-center justify-content-center" style="height: 280px;">
                <canvas id="chartCostosDoughnut"></canvas>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-12">
        <div class="card border-0 shadow-sm rounded-3 p-4 bg-white">
            <h3 class="h6 fw-bold text-dark mb-3">
                <i class="bi bi-table me-2"></i>Detalle por Categoría de Gasto
            </h3>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3 text-uppercase text-muted small fw-semibold">Categoría</th>
                            <th class="text-uppercase text-muted small fw-semibold">Total</th>
                            <th class="text-uppercase text-muted small fw-semibold">% del Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (gastos_categoria && gastos_categoria.length > 0) { %>
                            <% gastos_categoria.forEach(function(g) { %>
                                <tr>
                                    <td class="ps-3 fw-medium text-dark small"><%= g._id %></td>
                                    <td class="fw-semibold text-dark"><%= formatoPrecio(g.total) %></td>
                                    <td class="text-muted small"><%= gastos_total > 0 ? ((g.total / gastos_total) * 100).toFixed(1) : 0 %>%</td>
                                </tr>
                            <% }); %>
                        <% } else { %>
                            <tr>
                                <td colspan="3" class="text-center py-4 text-muted">No hay gastos en este período</td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<% } else { %>
    <div class="alert alert-info">
        <i class="bi bi-info-circle me-2"></i> No hay datos financieros para mostrar en este período.
    </div>
<% } %>

<%- include('../partials/footer') %>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function () {
    const formatCOP = (val) => '$ ' + Math.round(Number(val) || 0).toLocaleString('es-CO');

    <% if (typeof ingresos !== 'undefined') { %>
    const ctxBar = document.getElementById('chartPnG');
    if (ctxBar) {
        new Chart(ctxBar, {
            type: 'bar',
            data: {
                labels: ['Ingresos', 'Costos', 'Gastos', 'Utilidad Bruta', 'Utilidad Neta'],
                datasets: [{
                    label: 'Valor ($)',
                    data: [<%= ingresos %>, <%= costos %>, <%= gastos_total %>, <%= utilidad_bruta %>, <%= utilidad_neta %>],
                    backgroundColor: [
                        'rgba(16, 185, 129, 0.85)',
                        'rgba(239, 68, 68, 0.85)',
                        'rgba(245, 158, 11, 0.85)',
                        'rgba(59, 130, 246, 0.85)',
                        '<%= utilidad_neta >= 0 ? "rgba(16, 185, 129, 0.85)" : "rgba(239, 68, 68, 0.85)" %>'
                    ],
                    borderColor: ['#10b981', '#ef4444', '#f59e0b', '#3b82f6', '<%= utilidad_neta >= 0 ? "#10b981" : "#ef4444" %>'],
                    borderWidth: 1.5,
                    borderRadius: 6,
                    maxBarThickness: 40
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: {
                    y: { beginAtZero: true, grid: { color: 'rgba(226, 232, 240, 0.65)' }, ticks: { callback: (v) => formatCOP(v) } },
                    x: { grid: { display: false } }
                }
            }
        });
    }

    const ctxDoughnut = document.getElementById('chartCostosDoughnut');
    if (ctxDoughnut && <%= gastos_total %> > 0) {
        const catLabels = [<%- gastos_categoria.map(g => "'" + g._id + "'").join(',') %>];
        const catTotals = [<%- gastos_categoria.map(g => g.total).join(',') %>];
        new Chart(ctxDoughnut, {
            type: 'doughnut',
            data: {
                labels: catLabels,
                datasets: [{
                    data: catTotals,
                    backgroundColor: ['#ef4444', '#f59e0b', '#3b82f6', '#8b5cf6', '#10b981', '#06b6d4', '#ec4899', '#64748b'],
                    borderWidth: 2, borderColor: '#ffffff'
                }]
            },
            options: { responsive: true, maintainAspectRatio: false, cutout: '66%',
                plugins: { legend: { position: 'bottom', labels: { usePointStyle: true, pointStyle: 'circle', padding: 10, font: { size: 11 } } } }
            }
        });
    }
    <% } %>
});
</script>

<style>
.pg-kpi-card { transition: transform 0.2s ease, box-shadow 0.2s ease; border-color: #e2e8f0 !important; }
.pg-kpi-card:hover { transform: translateY(-2px); box-shadow: 0 8px 20px rgba(0, 0, 0, 0.06) !important; }
.pg-kpi-label { letter-spacing: 0.03em; font-size: 0.72rem; }
.pg-kpi-icon { width: 42px; height: 42px; display: flex; align-items: center; justify-content: center; }
</style>