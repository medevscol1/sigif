<%- include('../partials/header') %>

<header class="dashboard-header">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4 pb-2 border-bottom">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1 rounded-pill fw-semibold">
                    <i class="bi bi-receipt-cutoff me-1"></i>Egresos Operacionales
                </span>
                <h2 class="h3 fw-bold text-dark mb-0">Historial de Gastos Operativos</h2>
            </div>
            <p class="text-muted small mb-0">Control y auditoría de egresos del negocio (alquiler, nómina, repuestos, servicios, etc.).</p>
        </div>
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <form method="get" class="d-flex align-items-center gap-2 flex-wrap">
                <input type="hidden" name="periodo" value="<%= periodo %>">
                <input type="hidden" name="desde" value="<%= inicio ? inicio.toISOString().split('T')[0] : '' %>">
                <input type="hidden" name="hasta" value="<%= fin ? fin.toISOString().split('T')[0] : '' %>">
                <select name="periodo" class="form-select form-select-sm shadow-none" onchange="this.form.submit()" style="max-width: 150px;">
                    <option value="hoy" <%= periodo === 'hoy' ? 'selected' : '' %>>Hoy</option>
                    <option value="semana" <%= periodo === 'semana' ? 'selected' : '' %>>Esta semana</option>
                    <option value="mes" <%= periodo === 'mes' ? 'selected' : '' %>>Este mes</option>
                    <option value="ano" <%= periodo === 'ano' ? 'selected' : '' %>>Este año</option>
                    <option value="personalizado" <%= periodo === 'personalizado' ? 'selected' : '' %>>Personalizado</option>
                </select>
                <% if (periodo === 'personalizado') { %>
                    <input type="date" name="desde" value="<%= inicio ? inicio.toISOString().split('T')[0] : '' %>" class="form-control form-control-sm shadow-none" style="max-width: 130px;">
                    <input type="date" name="hasta" value="<%= fin ? fin.toISOString().split('T')[0] : '' %>" class="form-control form-control-sm shadow-none" style="max-width: 130px;">
                <% } %>
                <select name="categoria" class="form-select form-select-sm shadow-none" onchange="this.form.submit()" style="max-width: 170px;">
                    <option value="">Todas las categorías</option>
                    <% categorias_opciones.forEach(function(cat) { %>
                        <option value="<%= cat %>" <%= filtro_categoria_actual === cat ? 'selected' : '' %>><%= cat %></option>
                    <% }); %>
                </select>
                <select name="metodo_pago" class="form-select form-select-sm shadow-none" onchange="this.form.submit()" style="max-width: 150px;">
                    <option value="">Todos los medios</option>
                    <% metodos_opciones.forEach(function(met) { %>
                        <option value="<%= met %>" <%= filtro_metodo_actual === met ? 'selected' : '' %>><%= met %></option>
                    <% }); %>
                </select>
                <a href="/finanzas/gastos" class="btn btn-sm btn-light border text-muted" title="Limpiar filtros"><i class="bi bi-arrow-counterclockwise"></i></a>
            </form>
            <% if (request.session.logueado && request.session.logueado.rol !== 'Empleado') { %>
            <a href="/finanzas/gastos/nuevo" class="btn btn-danger btn-sm rounded-2 d-flex align-items-center gap-1 shadow-sm px-3 py-2 fw-medium">
                <i class="bi bi-plus-circle-fill"></i> Registrar nuevo gasto
            </a>
            <% } %>
            <button class="btn btn-outline-secondary btn-sm rounded-2 d-flex align-items-center gap-1 shadow-xs px-3 py-2" onclick="window.print()">
                <i class="bi bi-printer"></i> Imprimir
            </button>
        </div>
    </div>
</header>

<% if (typeof gastos_total !== 'undefined') { %>
<div class="row g-3 mb-4">
    <div class="col-xl-3 col-md-6">
        <div class="card pg-kpi-card shadow-sm h-100 p-3 bg-white rounded-3 border">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <div>
                    <span class="pg-kpi-label text-muted fw-semibold small text-uppercase">Total Gastos Operativos</span>
                    <div class="pg-kpi-value text-danger fw-bold fs-4 mt-1"><%= formatoPrecio(gastos_total) %></div>
                </div>
                <div class="pg-kpi-icon bg-danger-subtle text-danger rounded-3 p-2">
                    <i class="bi bi-arrow-down-circle fs-5"></i>
                </div>
            </div>
            <div class="d-flex align-items-center gap-2 text-muted small pt-2 border-top">
                <i class="bi bi-receipt text-danger"></i>
                <span><%= gastos.count %> egresos contabilizados</span>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="card pg-kpi-card shadow-sm h-100 p-3 bg-white rounded-3 border">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <div>
                    <span class="pg-kpi-label text-muted fw-semibold small text-uppercase">Rubro Principal</span>
                    <div class="pg-kpi-value text-dark fw-bold fs-5 mt-1"><%= categoria_mayor_gasto ? categoria_mayor_gasto._id : '—' %></div>
                </div>
                <div class="pg-kpi-icon bg-secondary-subtle text-secondary rounded-3 p-2">
                    <i class="bi bi-award fs-5"></i>
                </div>
            </div>
            <div class="d-flex align-items-center gap-2 text-muted small pt-2 border-top">
                <i class="bi bi-tag text-secondary"></i>
                <span><%= categoria_mayor_gasto ? formatoPrecio(categoria_mayor_gasto.total) : '—' %></span>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="card pg-kpi-card shadow-sm h-100 p-3 bg-white rounded-3 border">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <div>
                    <span class="pg-kpi-label text-muted fw-semibold small text-uppercase">Salidas en Efectivo</span>
                    <div class="pg-kpi-value text-dark fw-bold fs-4 mt-1"><%= formatoPrecio(gastos_efectivo) %></div>
                </div>
                <div class="pg-kpi-icon bg-secondary-subtle text-secondary rounded-3 p-2">
                    <i class="bi bi-cash-stack fs-5"></i>
                </div>
            </div>
            <div class="d-flex align-items-center gap-2 text-muted small pt-2 border-top">
                <i class="bi bi-wallet2 text-secondary"></i>
                <span>Egresos directos de caja</span>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="card pg-kpi-card shadow-sm h-100 p-3 bg-white rounded-3 border">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <div>
                    <span class="pg-kpi-label text-muted fw-semibold small text-uppercase">Pagos Bancarizados</span>
                    <div class="pg-kpi-value text-primary fw-bold fs-4 mt-1"><%= formatoPrecio(gastos_bancos) %></div>
                </div>
                <div class="pg-kpi-icon bg-primary-subtle text-primary rounded-3 p-2">
                    <i class="bi bi-bank fs-5"></i>
                </div>
            </div>
            <div class="d-flex align-items-center gap-2 text-muted small pt-2 border-top">
                <i class="bi bi-credit-card text-primary"></i>
                <span>Transferencias y tarjetas</span>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm rounded-3 p-4 h-100 bg-white">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h3 class="h6 fw-bold text-dark mb-1">
                        <i class="bi bi-bar-chart-fill text-danger me-2"></i>Desembolsos por Categoría
                    </h3>
                    <p class="text-muted small mb-0">Total gastado en cada rubro operativo durante el período</p>
                </div>
                <span class="badge bg-danger-subtle text-danger small">Distribución</span>
            </div>
            <div class="chart-container position-relative" style="height: 280px;">
                <canvas id="chartGastosBar"></canvas>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card border-0 shadow-sm rounded-3 p-4 h-100 bg-white">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h3 class="h6 fw-bold text-dark mb-1">
                        <i class="bi bi-pie-chart-fill text-warning me-2"></i>Composición de Gastos (%)
                    </h3>
                    <p class="text-muted small mb-0">Cuota porcentual sobre el total desembolsado</p>
                </div>
            </div>
            <div class="chart-container position-relative d-flex align-items-center justify-content-center" style="height: 280px;">
                <canvas id="chartGastosDoughnut"></canvas>
            </div>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-3 p-4 mb-4 bg-white">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-3">
        <div>
            <h3 class="h6 fw-bold text-dark mb-1">
                <i class="bi bi-list-check text-danger me-2"></i>Detalle Cronológico de Egresos
            </h3>
            <p class="text-muted small mb-0">Listado de comprobantes y pagos operativos registrados</p>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 pg-tabla-gastos">
            <thead class="table-light">
                <tr>
                    <th class="ps-3 text-uppercase text-muted small fw-semibold" style="width: 120px;">Fecha</th>
                    <th class="text-uppercase text-muted small fw-semibold">Concepto / Motivo</th>
                    <th class="text-uppercase text-muted small fw-semibold">Categoría</th>
                    <th class="text-uppercase text-muted small fw-semibold">Proveedor / Beneficiario</th>
                    <th class="text-uppercase text-muted small fw-semibold">Método</th>
                    <th class="text-uppercase text-muted small fw-semibold">Usuario</th>
                    <th class="text-end text-uppercase text-muted small fw-semibold" style="width: 140px;">Valor</th>
                    <th class="text-center text-uppercase text-muted small fw-semibold" style="width: 100px;">Acciones</th>
                </tr>
            </thead>
            <tbody>
                <% if (gastos && gastos.length > 0) { %>
                    <% gastos.forEach(function(g) { %>
                        <tr>
                            <td class="ps-3 fw-medium text-dark small"><%= new Date(g.fecha).toLocaleDateString('es-CO') %></td>
                            <td>
                                <span class="fw-semibold text-dark d-block"><%= g.concepto %></span>
                                <% if (g.descripcion) { %>
                                    <small class="text-muted text-truncate d-block" style="max-width: 250px;"><%= g.descripcion %></small>
                                <% } %>
                            </td>
                            <td>
                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1 rounded-pill small">
                                    <%= g.categoria %>
                                </span>
                            </td>
                            <td class="text-muted small"><%= g.proveedor || '—' %></td>
                            <td>
                                <span class="badge bg-light text-muted border small"><%= g.metodo_pago %></span>
                            </td>
                            <td class="text-muted small"><%= g.usuario || 'Admin' %></td>
                            <td class="text-end fw-bold text-danger fs-6"><%= formatoPrecio(g.valor) %></td>
                            <td class="text-center pe-3">
                                <% if (request.session.logueado && request.session.logueado.rol !== 'Empleado') { %>
                                <div class="btn-group btn-group-sm">
                                    <a href="/finanzas/gastos/editar/<%= g._id %>" class="btn btn-outline-primary rounded-2" title="Editar">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <form method="post" action="/finanzas/gastos/eliminar/<%= g._id %>" class="d-inline" onsubmit="return confirm('¿Eliminar este gasto?')">
                                        <button type="submit" class="btn btn-outline-danger rounded-2" title="Eliminar">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                                <% } %>
                            </td>
                        </tr>
                    <% }); %>
                <% } else { %>
                    <tr>
                        <td colspan="9" class="text-center py-5 text-muted">
                            <i class="bi bi-receipt fs-1 d-block mb-2 text-secondary opacity-50"></i>
                            <h6 class="fw-semibold text-dark">No hay gastos registrados en este período</h6>
                            <p class="small mb-0">Utiliza el botón «Registrar nuevo gasto» para agregar comprobantes.</p>
                        </td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
</div>

<% } else { %>
    <div class="alert alert-info text-center py-5">
        <i class="bi bi-receipt fs-1 d-block mb-2 text-secondary opacity-50"></i>
        <h5 class="fw-semibold text-dark">No hay datos de gastos en este período</h5>
    </div>
<% } %>

<%- include('../partials/footer') %>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function () {
    <% if (typeof gastos_total !== 'undefined' && gastos_por_categoria && gastos_por_categoria.length > 0) { %>
    const formatCOP = (val) => '$ ' + Math.round(Number(val) || 0).toLocaleString('es-CO');

    const catLabels = [<%- gastos_por_categoria.map(g => "'" + g._id + "'").join(',') %>];
    const catTotals = [<%- gastos_por_categoria.map(g => g.total).join(',') %>];

    const ctxBar = document.getElementById('chartGastosBar');
    if (ctxBar) {
        new Chart(ctxBar, {
            type: 'bar', data: { labels: catLabels, datasets: [{ label: 'Total Gastado ($)', data: catTotals, backgroundColor: 'rgba(239, 68, 68, 0.85)', borderColor: '#ef4444', borderWidth: 1.5, borderRadius: 6, maxBarThickness: 35 }] },
            options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true, grid: { color: 'rgba(226, 232, 240, 0.65)' }, ticks: { callback: (v) => formatCOP(v) } }, x: { grid: { display: false } } } }
        });
    }

    const ctxDoughnut = document.getElementById('chartGastosDoughnut');
    if (ctxDoughnut) {
        new Chart(ctxDoughnut, {
            type: 'doughnut', data: { labels: catLabels, datasets: [{ data: catTotals, backgroundColor: ['#ef4444', '#f59e0b', '#3b82f6', '#8b5cf6', '#10b981', '#06b6d4', '#ec4899', '#64748b'], borderWidth: 2, borderColor: '#ffffff' }] },
            options: { responsive: true, maintainAspectRatio: false, cutout: '66%', plugins: { legend: { position: 'bottom', labels: { usePointStyle: true, pointStyle: 'circle', padding: 10, font: { size: 11 } } } } }
        });
    }
    <% } %>
});
</script>

<style>
.pg-gastos { color: #1e293b; }
.pg-kpi-card { transition: transform 0.2s ease, box-shadow 0.2s ease; border-color: #e2e8f0 !important; }
.pg-kpi-card:hover { transform: translateY(-2px); box-shadow: 0 8px 20px rgba(0, 0, 0, 0.06) !important; }
.pg-kpi-label { letter-spacing: 0.03em; font-size: 0.72rem; }
.pg-kpi-icon { width: 42px; height: 42px; display: flex; align-items: center; justify-content: center; }
.pg-tabla-gastos th, .pg-tabla-gastos td { padding: 12px 14px; }
.shadow-xs { box-shadow: 0 1px 2px rgba(0,0,0,0.04); }
</style>