<%- include('../partials/header') %>

<header class="dashboard-header">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4 pb-2 border-bottom">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 rounded-pill fw-semibold">
                    <i class="bi bi-graph-up me-1"></i>Rentabilidad de Inventario
                </span>
                <h2 class="h3 fw-bold text-dark mb-0">Márgenes de Ganancia por Rotación</h2>
            </div>
            <p class="text-muted small mb-0">Análisis de rentabilidad obtenida por rotación de repuestos en el período.</p>
        </div>
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <form method="get" class="d-flex align-items-center gap-2">
                <input type="hidden" name="periodo" value="<%= periodo %>">
                <select name="periodo" class="form-select form-select-sm shadow-none" onchange="this.form.submit()" style="max-width: 180px;">
                    <option value="hoy" <%= periodo === 'hoy' ? 'selected' : '' %>>Hoy</option>
                    <option value="semana" <%= periodo === 'semana' ? 'selected' : '' %>>Esta semana</option>
                    <option value="mes" <%= periodo === 'mes' ? 'selected' : '' %>>Este mes</option>
                    <option value="ano" <%= periodo === 'ano' ? 'selected' : '' %>>Este año</option>
                </select>
            </form>
        </div>
    </div>
</header>

<% if (productos_rentabilidad && productos_rentabilidad.length > 0) { %>
<div class="row g-3 mb-4">
    <div class="col-xl-4 col-md-6">
        <div class="card pg-kpi-card shadow-sm h-100 p-3 bg-white rounded-3 border border-success">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <div>
                    <span class="pg-kpi-label text-muted fw-semibold small text-uppercase">Producto Más Rentable</span>
                    <div class="pg-kpi-value text-success fw-bold fs-5 mt-1"><%= productos_rentabilidad[0] ? productos_rentabilidad[0].producto : '—' %></div>
                </div>
                <div class="pg-kpi-icon bg-success-subtle text-success rounded-3 p-2">
                    <i class="bi bi-cash-coin fs-5"></i>
                </div>
            </div>
            <div class="d-flex align-items-center gap-2 text-muted small pt-2 border-top">
                <i class="bi bi-percent text-success"></i>
                <span>Ganancia: <%= productos_rentabilidad[0] ? formatoPrecio(productos_rentabilidad[0].ganancia) : '—' %></span>
            </div>
        </div>
    </div>

    <div class="col-xl-4 col-md-6">
        <div class="card pg-kpi-card shadow-sm h-100 p-3 bg-white rounded-3 border border-primary">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <div>
                    <span class="pg-kpi-label text-muted fw-semibold small text-uppercase">Más Vendido (Unidades)</span>
                    <div class="pg-kpi-value text-primary fw-bold fs-5 mt-1"><%= mas_vendidos[0] ? mas_vendidos[0].producto : '—' %></div>
                </div>
                <div class="pg-kpi-icon bg-primary-subtle text-primary rounded-3 p-2">
                    <i class="bi bi-box-seam fs-5"></i>
                </div>
            </div>
            <div class="d-flex align-items-center gap-2 text-muted small pt-2 border-top">
                <i class="bi bi-123 text-primary"></i>
                <span><%= mas_vendidos[0] ? mas_vendidos[0].cantidad : 0 %> unidades</span>
            </div>
        </div>
    </div>

    <div class="col-xl-4 col-md-6">
        <div class="card pg-kpi-card shadow-sm h-100 p-3 bg-white rounded-3 border border-info">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <div>
                    <span class="pg-kpi-label text-muted fw-semibold small text-uppercase">Mayor Margen %</span>
                    <div class="pg-kpi-value text-info fw-bold fs-5 mt-1"><%= mayor_margen[0] ? mayor_margen[0].producto : '—' %></div>
                </div>
                <div class="pg-kpi-icon bg-info-subtle text-info rounded-3 p-2">
                    <i class="bi bi-graph-up-arrow fs-5"></i>
                </div>
            </div>
            <div class="d-flex align-items-center gap-2 text-muted small pt-2 border-top">
                <i class="bi bi-percent text-info"></i>
                <span>Margen: <%= mayor_margen[0] ? mayor_margen[0].margen.toFixed(1) : 0 %>%</span>
            </div>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-3 p-4 bg-white">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-3">
        <div>
            <h3 class="h6 fw-bold text-dark mb-1">
                <i class="bi bi-table me-2"></i>Rentabilidad Detallada por Producto
            </h3>
            <p class="text-muted small mb-0">Ordenado por ganancia descendente</p>
        </div>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-3 text-uppercase text-muted small fw-semibold">Producto</th>
                    <th class="text-end text-uppercase text-muted small fw-semibold">Cantidad</th>
                    <th class="text-end text-uppercase text-muted small fw-semibold">Ingresos</th>
                    <th class="text-end text-uppercase text-muted small fw-semibold">Costos</th>
                    <th class="text-end text-uppercase text-muted small fw-semibold">Ganancia</th>
                    <th class="text-end text-uppercase text-muted small fw-semibold">Margen %</th>
                    <th class="text-end text-uppercase text-muted small fw-semibold">Rotación %</th>
                </tr>
            </thead>
            <tbody>
                <% productos_rentabilidad.forEach(function(p) { %>
                    <tr>
                        <td class="ps-3 fw-medium text-dark small"><%= p.producto %></td>
                        <td class="text-end text-muted small"><%= p.cantidad %></td>
                        <td class="text-end fw-semibold text-success"><%= formatoPrecio(p.ingresos) %></td>
                        <td class="text-end fw-semibold text-danger"><%= formatoPrecio(p.costos) %></td>
                        <td class="text-end fw-bold <%= p.ganancia >= 0 ? 'text-success' : 'text-danger' %>"><%= formatoPrecio(p.ganancia) %></td>
                        <td class="text-end <%= p.margen >= 20 ? 'text-success fw-bold' : (p.margen >= 0 ? 'text-warning fw-bold' : 'text-danger fw-bold') %>"><%= p.margen.toFixed(1) %>%</td>
                        <td class="text-end text-muted small"><%= p.rotacion ? p.rotacion.toFixed(1) : 0 %>%</td>
                    </tr>
                <% }); %>
            </tbody>
        </table>
    </div>
</div>

<% } else { %>
    <div class="alert alert-info text-center py-5">
        <i class="bi bi-graph-up fs-1 d-block mb-2 text-secondary opacity-50"></i>
        <h5 class="fw-semibold text-dark">No hay datos de rentabilidad en este período</h5>
    </div>
<% } %>

<%- include('../partials/footer') %>

<style>
.pg-kpi-card { transition: transform 0.2s ease, box-shadow 0.2s ease; border-color: #e2e8f0 !important; }
.pg-kpi-card:hover { transform: translateY(-2px); box-shadow: 0 8px 20px rgba(0, 0, 0, 0.06) !important; }
.pg-kpi-label { letter-spacing: 0.03em; font-size: 0.72rem; }
.pg-kpi-icon { width: 42px; height: 42px; display: flex; align-items: center; justify-content: center; }
</style>