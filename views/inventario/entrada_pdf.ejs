<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Factura de Entrada <%= entrada.numeroFactura ? entrada.numeroFactura() : 'ENT-' + String(entrada.numero || entrada._id).padStart(6, '0') %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { font-family: 'Helvetica Neue', Arial, sans-serif; font-size: 11px; color: #1e293b; padding: 20px; }
        .header { text-align: center; margin-bottom: 20px; border-bottom: 2px solid #1e2a44; padding-bottom: 15px; }
        .logo { max-width: 120px; margin-bottom: 10px; }
        .title { font-size: 20px; font-weight: bold; color: #1e2a44; margin: 0; }
        .subtitle { font-size: 13px; color: #64748b; margin: 5px 0 0; }
        .info-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 8px; margin-bottom: 20px; font-size: 11px; }
        .info-label { font-weight: bold; color: #334155; }
        .info-value { color: #1e293b; }
        table { width: 100%; border-collapse: collapse; margin-bottom: 15px; font-size: 10px; }
        th { background: #1e2a44; color: white; padding: 8px; text-align: left; font-weight: 600; }
        td { padding: 7px 8px; border-bottom: 1px solid #e2e8f0; }
        tr:nth-child(even) td { background: #f8fafc; }
        .total-row { background: #05a77b !important; color: white; font-weight: bold; }
        .totals { display: flex; justify-content: flex-end; gap: 20px; margin-top: 10px; }
        .total-box { text-align: right; }
        .total-label { font-size: 10px; color: #64748b; text-transform: uppercase; }
        .total-amount { font-size: 16px; font-weight: bold; color: #1e2a44; }
        .footer { margin-top: 30px; text-align: center; font-size: 9px; color: #94a3b8; border-top: 1px solid #e2e8f0; padding-top: 15px; }
        @media print { body { padding: 0; } .no-print { display: none !important; } }
    </style>
</head>
<body>
    <div class="header">
        <% if (entrada.empresa && entrada.empresa.logo) { %>
            <img src="<%= entrada.empresa.logo %>" class="logo" alt="Logo">
        <% } %>
        <h1 class="title">FACTURA DE ENTRADA</h1>
        <p class="subtitle"><%= entrada.numeroFactura ? entrada.numeroFactura() : 'ENT-' + String(entrada.numero || entrada._id).padStart(6, '0') %></p>
    </div>

    <div class="info-grid">
        <div><span class="info-label">Proveedor:</span> <span class="info-value"><%= entrada.proveedor %></span></div>
        <div><span class="info-label">Documento:</span> <span class="info-value"><%= entrada.documento || '—' %></span></div>
        <div><span class="info-label">Fecha:</span> <span class="info-value"><%= new Date(entrada.fecha).toLocaleString('es-CO') %></span></div>
        <div><span class="info-label">Registrado por:</span> <span class="info-value"><%= entrada.usuario || 'Sistema' %></span></div>
        <% if (entrada.observaciones) { %>
        <div style="grid-column: span 2;"><span class="info-label">Observaciones:</span> <span class="info-value"><%= entrada.observaciones %></span></div>
        <% } %>
    </div>

    <table>
        <thead>
            <tr>
                <th style="width: 40%;">Producto</th>
                <th style="width: 12%; text-align: center;">Cantidad</th>
                <th style="width: 24%; text-align: right;">Precio Unit.</th>
                <th style="width: 24%; text-align: right;">Subtotal</th>
            </tr>
        </thead>
        <tbody>
            <% if (entrada.detalles && entrada.detalles.length > 0) { %>
                <% entrada.detalles.forEach(function(d) { %>
                    <tr>
                        <td><%= d.producto ? d.producto.nombre : d.producto %></td>
                        <td style="text-align: center;"><%= d.cantidad %></td>
                        <td style="text-align: right;"><%= formatoPrecio(d.precio) %></td>
                        <td style="text-align: right;"><%= formatoPrecio(d.subtotal) %></td>
                    </tr>
                <% }); %>
            <% } %>
            <tr class="total-row">
                <td colspan="3" style="text-align: right;">TOTAL:</td>
                <td style="text-align: right;"><%= formatoPrecio(entrada.total) %></td>
            </tr>
        </tbody>
    </table>

    <div class="totals">
        <div class="total-box">
            <div class="total-label">Total Entrada</div>
            <div class="total-amount"><%= formatoPrecio(entrada.total) %></div>
        </div>
    </div>

    <div class="footer">
        <p>Documento interno de ingreso de mercancía - No válido como factura fiscal</p>
        <p>SIGIF - Sistema Integral de Gestión de Inventarios y Facturación</p>
    </div>

    <script>
        window.onload = function() { window.print(); }
    </script>
</body>
</html>