<%- include('../partials/header') %>

<section class="product-form-page">
  <div class="product-form-shell">
    <div class="product-form-header">
      <div>
        <p class="eyebrow">Productos</p>
        <h1>Actualizar producto</h1>
      </div>
      <a href="/productos" class="btn-link-back">← Volver</a>
    </div>

    <% if (producto) { %>
      <form action="/productos/editar/<%= producto._id %>" method="post" class="product-form">
        <div class="form-grid">
          <div class="form-field">
            <label>Nombre</label>
            <input name="nombre" type="text" value="<%= producto.nombre %>" required />
          </div>

          <div class="form-field">
            <label>Categoría</label>
            <input name="categoria" type="text" value="<%= producto.categoria %>" required />
          </div>

          <div class="form-field">
            <label>Precio</label>
            <input name="precio" type="number" step="0.01" min="0" value="<%= Number((producto.precio && producto.precio.toString) ? producto.precio.toString() : (producto.precio || 0)).toString() %>" required />
          </div>

          <div class="form-field">
            <label>Stock</label>
            <input name="stock" type="number" min="0" value="<%= producto.stock || 0 %>" />
          </div>
        </div>

        <div class="form-field full-width">
          <label>Descripción</label>
          <textarea name="descripcion" rows="4"><%= producto.descripcion || '' %></textarea>
        </div>

        <label class="checkbox-row">
          <input type="checkbox" name="activo" <%= producto.activo ? 'checked' : '' %> />
          <span>Producto activo</span>
        </label>

        <div class="form-actions">
          <button type="submit" class="btn-primary-action">Guardar cambios</button>
          <a href="/productos" class="btn-secondary-action">Cancelar</a>
        </div>
      </form>
    <% } else { %>
      <div class="no-results">Producto no encontrado.</div>
    <% } %>
  </div>
</section>

<%- include('../partials/footer') %>
