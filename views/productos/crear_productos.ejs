<%- include('../partials/header') %>

<section>
  <h1>Crear Producto</h1>
  <form action="/productos/crear" method="post">
    <div class="mb-3">
      <label class="form-label">Nombre</label>
      <input name="nombre" class="form-control" required />
    </div>
    <div class="mb-3">
      <label class="form-label">Descripción</label>
      <input name="descripcion" class="form-control" />
    </div>
    <div class="mb-3">
      <label class="form-label">Precio</label>
      <input name="precio" type="number" step="0.01" class="form-control" required />
    </div>
    <div class="mb-3">
      <label class="form-label">Stock</label>
      <input name="stock" type="number" class="form-control" value="0" />
    </div>
    <div class="mb-3">
      <label class="form-label">Categoría</label>
      <input name="categoria" class="form-control" required />
    </div>
    <div class="mb-3 form-check">
      <input type="checkbox" name="activo" class="form-check-input" id="activo" checked>
      <label class="form-check-label" for="activo">Activo</label>
    </div>
    <button class="btn btn-primary" type="submit">Crear</button>
    <a href="/productos" class="btn btn-secondary">Cancelar</a>
  </form>
</section>

<%- include('../partials/footer') %>
