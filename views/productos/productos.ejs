<%- include('../partials/header') %>

<section>
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Productos</h1>
    <a href="/productos/crear" class="btn btn-success">Agregar producto</a>
  </div>

  <% if (productos && productos.length) { %>
    <table class="table">
      <thead>
        <tr>
          <th>Nombre</th>
          <th>Categoría</th>
          <th>Precio</th>
          <th>Stock</th>
          <th>Acciones</th>
        </tr>
      </thead>
      <tbody>
        <% productos.forEach(function(p){ %>
          <tr>
            <td><%= p.nombre %></td>
            <td><%= p.categoria %></td>
            <td><%= (p.precio && p.precio.toString) ? p.precio.toString() : p.precio %></td>
            <td><%= p.stock %></td>
            <td>
              <a class="btn btn-sm btn-primary" href="/productos/editar/<%= p._id %>">Editar</a>
              <form action="/productos/eliminar/<%= p._id %>" method="post" style="display:inline-block;" onsubmit="return confirm('Eliminar producto?');">
                <button class="btn btn-sm btn-danger" type="submit">Eliminar</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } else { %>
    <p>No hay productos aún.</p>
  <% } %>
</section>

<%- include('../partials/footer') %>
