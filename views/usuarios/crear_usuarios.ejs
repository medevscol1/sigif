<%- include('../partials/header') %>

<header class="inventario-header">
    <div>
        <h1>Gestión de usuarios</h1>
    </div>
</header>

<section class="inventario-container2">

    <div class="cv-toolbar mb-4">
        <div class="cv-toolbar-left">
            <h2 class="cv-title">Crear nuevo usuario</h2>
            <p class="cv-subtitle">Registra un nuevo usuario en el sistema con sus credenciales y permisos de acceso</p>
        </div>
        <div class="cv-toolbar-right">
            <a href="/usuarios" class="cs-filtro-btn" style="padding: 9px 18px; text-decoration: none; display: inline-flex; align-items: center; gap: 6px; background: #fff; border: 1px solid #cbd5e1; color: #475569; font-weight: 600;">
                <i class="bi bi-arrow-left"></i> Volver a la lista
            </a>
        </div>
    </div>

    <% if (typeof messages !== 'undefined' && messages.length) { %>
        <% messages.forEach(function(message){ %>
        <% const tags = message.tags || message.type || 'info'; %>
        <div class="alert <%= tags.includes('error') ? 'alert-danger' : tags.includes('warning') ? 'alert-warning' : tags.includes('success') ? 'alert-success' : 'alert-info' %> alert-dismissible fade show mb-4" role="alert">
            <%= message.text || message.message || message %>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
        <% }) %>
    <% } %>

    <% if (typeof formErrors !== 'undefined' && formErrors) { %>
    <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
        <div class="d-flex align-items-center gap-2">
            <i class="bi bi-exclamation-triangle-fill fs-5"></i>
            <strong>Por favor corrige los siguientes errores:</strong>
        </div>
        <ul class="mb-0 mt-2">
            <% Object.keys(formErrors).forEach(function(field){ %>
                <li><strong><%= field %>:</strong> <%= formErrors[field] %></li>
            <% }) %>
        </ul>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
    <% } %>

    <div class="form-card-responsive" style="background:#fff;border:1px solid #e2e8f0;border-radius:12px;overflow:hidden;">
        <div class="form-card-header" style="display:flex;justify-content:space-between;align-items:center;padding:18px 22px;background:#f8fafc;border-bottom:1px solid #e2e8f0;">
            <div class="form-card-header-left" style="display:flex;align-items:center;gap:12px;">
                <div class="form-card-icon" style="width:38px;height:38px;border-radius:10px;background:#e0e7ff;color:#3a56e4;display:flex;align-items:center;justify-content:center;font-size:1.2rem;">
                    <i class="bi bi-person-plus-fill"></i>
                </div>
                <div>
                    <h3 class="form-card-title" style="margin:0;font-size:1rem;font-weight:700;color:#1e293b;">Información del Usuario</h3>
                    <span class="form-card-subtitle" style="font-size:0.8rem;color:#64748b;">Ingresa los datos personales, de acceso y rol de seguridad</span>
                </div>
            </div>
        </div>

        <form method="POST" action="/crear_usuarios" class="form-card-body" style="padding:22px;">
            <div class="row g-3 g-md-4">
                <!-- Nombre -->
                <div class="col-12 col-md-6">
                    <label for="nombre" class="form-label fw-semibold text-secondary small">
                        <i class="bi bi-person me-1 text-primary"></i> Nombre del empleado <span class="text-danger">*</span>
                    </label>
                    <input type="text" id="nombre" name="nombre" class="form-control" placeholder="Ej. Juan Pérez, María Gómez..." value="<%= typeof formData !== 'undefined' && formData.nombre ? formData.nombre : '' %>" required>
                </div>
                
                <div class="col-12 col-md-6">
                    <label for="documento" class="form-label fw-semibold text-secondary small">
                        <i class="bi bi-person me-1 text-primary"></i> Documento de identidad <span class="text-danger">*</span>
                    </label>
                    <input type="text" id="documento" name="documento" class="form-control" placeholder="Ej. 1234567890" inputmode="numeric" value="<%= typeof formData !== 'undefined' && formData.documento ? formData.documento : '' %>" required>
                </div>

                <!-- Correo -->
                <div class="col-12 col-md-6">
                    <label for="correo" class="form-label fw-semibold text-secondary small">
                        <i class="bi bi-envelope me-1 text-primary"></i> Correo electrónico <span class="text-danger">*</span>
                    </label>
                    <input type="email" id="correo" name="correo" class="form-control" placeholder="correo@empresa.com" value="<%= typeof formData !== 'undefined' && formData.correo ? formData.correo : '' %>" required>
                </div>

                <!-- Contraseña -->
                <div class="col-12 col-md-6">
                    <label for="contra" class="form-label fw-semibold text-secondary small">
                        <i class="bi bi-key me-1 text-primary"></i> Contraseña <span class="text-danger">*</span>
                    </label>
                    <input type="password" id="contra" name="contra" class="form-control" placeholder="********" required>
                </div>

                <!-- Teléfono -->
                <div class="col-12 col-md-6">
                    <label for="telefono" class="form-label fw-semibold text-secondary small">
                        <i class="bi bi-telephone me-1 text-primary"></i> Teléfono de contacto <span class="text-danger">*</span>
                    </label>
                    <input type="text" id="telefono" name="telefono" class="form-control" placeholder="Ej. 3001234567" inputmode="numeric" value="<%= typeof formData !== 'undefined' && formData.telefono ? formData.telefono : '' %>" required>
                </div>

                <!-- Rol / Cargo -->
                <div class="col-12 col-md-6">
                    <label for="cargo" class="form-label fw-semibold text-secondary small">
                        <i class="bi bi-shield-check me-1 text-primary"></i> Rol / Cargo en el sistema <span class="text-danger">*</span>
                    </label>
                    <select id="cargo" name="cargo" class="form-select">
                        <option value="Empleado" <%= (typeof formData !== 'undefined' && formData.cargo === 'Admin') ? '' : 'selected' %>>Empleado</option>
                        <option value="Admin" <%= (typeof formData !== 'undefined' && formData.cargo === 'Admin') ? 'selected' : '' %>>Admin</option>
                        <option value="SuperAdmin" <%= (typeof formData !== 'undefined' && formData.cargo === 'SuperAdmin') ? 'selected' : '' %>>SuperAdmin</option>
                    </select>
                </div>

                <!-- Fecha de Inicio -->
                <div class="col-12 col-md-6">
                    <label for="fecha_inicio" class="form-label fw-semibold text-secondary small">
                        <i class="bi bi-calendar-event me-1 text-primary"></i> Fecha de inicio / Contratación
                    </label>
                    <input type="date" id="fecha_inicio" name="fecha_inicio" class="form-control" value="<%= typeof formData !== 'undefined' && formData.fecha_inicio ? formData.fecha_inicio : '' %>">
                </div>
            
            </div>

            <!-- Botones de Acción -->
            <div class="form-card-actions" style="display:flex;justify-content:flex-end;gap:12px;margin-top:22px;padding-top:16px;border-top:1px solid #e2e8f0;">
                <a href="/usuarios" class="form-btn-cancel" style="padding:9px 18px;border:1px solid #cbd5e1;border-radius:8px;background:#fff;color:#475569;text-decoration:none;font-weight:600;">
                    Cancelar
                </a>
                <button type="submit" class="form-btn-submit" style="padding:9px 18px;border:none;border-radius:8px;background:linear-gradient(135deg,#3a56e4,#5c7cfa);color:#fff;font-weight:700;display:inline-flex;align-items:center;gap:6px;">
                    <i class="bi bi-person-check-fill"></i> Guardar Usuario
                </button>
            </div>

        </form>
    </div>

</section>
<script>
    document.addEventListener('DOMContentLoaded', function () {
        const fechaInicio = document.getElementById('fecha_inicio');
        if (fechaInicio) {
            const hoy = new Date().toISOString().split('T')[0];
            fechaInicio.max = hoy;
        }
    });
</script>

<%- include('../partials/footer') %>
