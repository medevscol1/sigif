<%- include('../partials/header') %>

<header class="inventario-header">
    <div>
        <h1>Gestión de usuarios</h1>
    </div>
</header>

<section class="inventario-container2">

    <div class="cv-toolbar mb-4">
        <div class="cv-toolbar-left">
            <h2 class="cv-title">Actualizar usuario</h2>
            <p class="cv-subtitle">Modifica la información personal, credenciales, permisos y estado del usuario</p>
        </div>
        <div class="cv-toolbar-right">
            <% const rol = (typeof request !== 'undefined' && request.session && request.session.logueado && request.session.logueado.rol) ? request.session.logueado.rol : ''; %>
            <% if (rol === 'Empleado') { %>
            <a href="/inicio" class="cs-filtro-btn" style="padding: 9px 18px; text-decoration: none; display: inline-flex; align-items: center; gap: 6px; background: #fff; border: 1px solid #cbd5e1; color: #475569; font-weight: 600;">
                <i class="bi bi-arrow-left"></i> Volver al inicio
            </a>
            <% } else { %>
            <a href="/usuarios" class="cs-filtro-btn" style="padding: 9px 18px; text-decoration: none; display: inline-flex; align-items: center; gap: 6px; background: #fff; border: 1px solid #cbd5e1; color: #475569; font-weight: 600;">
                <i class="bi bi-arrow-left"></i> Volver a la lista
            </a>
            <% } %>
        </div>
    </div>

    <% if (typeof messages !== 'undefined' && messages.length) { %>
    <% messages.forEach(function(message){ %>
    <% const tags = message.tags || message.type || 'info'; %>
    <div class="alert <%= tags.includes('error') ? 'alert-danger' : tags.includes('warning') ? 'alert-warning' : tags.includes('success') ? 'alert-success' : 'alert-info' %> alert-dismissible fade show mb-4" role="alert">
        <%= message.text || message.message || message %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
    <% }) %>
    <% } %>

    <% if (typeof formErrors !== 'undefined' && formErrors) { %>
    <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
        <div class="d-flex align-items-center gap-2">
            <i class="bi bi-exclamation-triangle-fill fs-5"></i>
            <strong>Por favor corrige los siguientes errores:</strong>
        </div>
        <ul class="mb-0 mt-2">
            <% Object.keys(formErrors).forEach(function(k){ %>
            <li><strong><%= k %>:</strong> <%= formErrors[k] %></li>
            <% }) %>
        </ul>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
    <% } %>

    <div class="form-card-responsive" style="background:#fff;border:1px solid #e2e8f0;border-radius:12px;overflow:hidden;">
        <div class="form-card-header" style="display:flex;justify-content:space-between;align-items:center;padding:18px 22px;background:#f8fafc;border-bottom:1px solid #e2e8f0;">
            <div class="form-card-header-left" style="display:flex;align-items:center;gap:12px;">
                <div class="form-card-icon" style="width:38px;height:38px;border-radius:10px;background:#e0e7ff;color:#3a56e4;display:flex;align-items:center;justify-content:center;font-size:1.2rem;">
                    <i class="bi bi-person-gear"></i>
                </div>
                <div>
                    <h3 class="form-card-title" style="margin:0;font-size:1rem;font-weight:700;color:#1e293b;">Editar Perfil de Usuario</h3>
                    <span class="form-card-subtitle" style="font-size:0.8rem;color:#64748b;">Actualiza los campos necesarios y confirma los cambios</span>
                </div>
            </div>
            <% if (typeof usuario !== 'undefined' && usuario && usuario._id) { %>
            <span class="ts-id" style="font-size: 0.85rem; font-weight: 700; color: #3a56e4; background: #e0e7ff; padding: 5px 14px; border-radius: 20px;">
                ID #<%= String(usuario._id).slice(-6) %>
            </span>
            <% } %>
        </div>

        <% if (typeof usuario !== 'undefined' && usuario) { %>
        <form method="POST" action="/editar_usuarios/<%= usuario._id %>" class="form-card-body" style="padding:22px;">

            <div class="row g-3 g-md-4">
                <!-- Nombre -->
                <div class="col-12 col-md-6">
                    <label for="nombre" class="form-label fw-semibold text-secondary small">
                        <i class="bi bi-person me-1 text-primary"></i> Nombre del empleado <span class="text-danger">*</span>
                    </label>
                    <input type="text" id="nombre" name="nombre" class="form-control" value="<%= usuario.nombre %>" required>
                </div>
                <div class="col-12 col-md-6">
                    <label for="documento" class="form-label fw-semibold text-secondary small">
                        <i class="bi bi-file-earmark-text me-1 text-primary"></i> Documento de identidad
                    </label>
                    <div class="form-control bg-light text-muted">
                        <%= usuario.documento %>
                    </div>
                    <input type="hidden" name="documento" value="<%= usuario.documento %>">
                </div>

                <!-- Correo -->
                <div class="col-12 col-md-6">
                    <label for="correo" class="form-label fw-semibold text-secondary small">
                        <i class="bi bi-envelope me-1 text-primary"></i> Correo electrónico <span class="text-danger">*</span>
                    </label>
                    <input type="email" id="correo" name="correo" class="form-control" value="<%= usuario.correo %>" required>
                </div>

                <!-- Contraseña -->
                <div class="col-12 col-md-6">
                    <label for="contra" class="form-label fw-semibold text-secondary small">
                        <i class="bi bi-key me-1 text-primary"></i> Contraseña
                    </label>
                    <input type="password" id="contra" name="contra" class="form-control" placeholder="Dejar vacío para no cambiar">
                    <small class="text-muted">
                        Deja este campo vacío si no deseas cambiar la contraseña.
                    </small>
                </div>

                <!-- Teléfono -->
                <div class="col-12 col-md-6">
                    <label for="telefono" class="form-label fw-semibold text-secondary small">
                        <i class="bi bi-telephone me-1 text-primary"></i> Teléfono de contacto <span class="text-danger">*</span>
                    </label>
                    <input type="text" id="telefono" name="telefono" class="form-control" value="<%= usuario.telefono %>" required>
                </div>

                <!-- Rol / Cargo -->
                <div class="col-12 col-md-6">
                    <label for="cargo" class="form-label fw-semibold text-secondary small">
                        <i class="bi bi-shield-check me-1 text-primary"></i> Rol / Cargo en el sistema <span class="text-danger">*</span>
                    </label>
                    <% const logueadoId = (typeof request !== 'undefined' && request.session && request.session.logueado && request.session.logueado.id) ? request.session.logueado.id : ''; %>
                    <% const logueadoRol = (typeof request !== 'undefined' && request.session && request.session.logueado && request.session.logueado.rol) ? request.session.logueado.rol : ''; %>
                    <% if (String(logueadoId) === String(usuario._id) || logueadoRol === 'Empleado') { %>
                    <div class="form-control bg-light fw-bold text-primary">
                        <%= usuario.cargo || 'Empleado' %>
                    </div>
                    <input type="hidden" name="cargo" value="<%= usuario.cargo || 'Empleado' %>">
                    <% } else { %>
                    <select id="cargo" name="cargo" class="form-select">
                        <option value="Empleado" <%= usuario.cargo === 'Empleado' ? 'selected' : '' %>>Empleado</option>
                        <option value="Admin" <%= usuario.cargo === 'Admin' ? 'selected' : '' %>>Admin</option>
                        <option value="SuperAdmin" <%= usuario.cargo === 'SuperAdmin' ? 'selected' : '' %>>SuperAdmin</option>
                    </select>
                    <% } %>
                </div>

                <div class="col-12 col-md-6">
                    <label class="form-label fw-semibold text-secondary small">
                        <i class="bi bi-calendar-event me-1 text-primary"></i> Fecha de inicio / Contratación
                    </label>
                    <div class="form-control bg-light">
                        <%= usuario.fecha_inicio ? new Date(usuario.fecha_inicio).toLocaleDateString('es-ES') : 'Reciente' %>
                    </div>
                </div>

            </div>

            <!-- Botones de Acción -->
            <div class="form-card-actions" style="display:flex;justify-content:flex-end;gap:12px;margin-top:22px;padding-top:16px;border-top:1px solid #e2e8f0;">
                <% if (logueadoRol === 'Empleado') { %>
                <a href="/inicio" class="form-btn-cancel" style="padding:9px 18px;border:1px solid #cbd5e1;border-radius:8px;background:#fff;color:#475569;text-decoration:none;font-weight:600;">
                    Cancelar
                </a>
                <% } else { %>
                <a href="/usuarios" class="form-btn-cancel" style="padding:9px 18px;border:1px solid #cbd5e1;border-radius:8px;background:#fff;color:#475569;text-decoration:none;font-weight:600;">
                    Cancelar
                </a>
                <% } %>
                <button type="submit" class="form-btn-submit" style="padding:9px 18px;border:none;border-radius:8px;background:linear-gradient(135deg,#3a56e4,#5c7cfa);color:#fff;font-weight:700;display:inline-flex;align-items:center;gap:6px;">
                    <i class="bi bi-save"></i> Guardar Cambios
                </button>
            </div>

        </form>
        <% } else { %>
            <div style="padding:22px;">
                <p>Usuario no encontrado.</p>
                <a href="/usuarios" class="btn btn-secondary">Volver</a>
            </div>
        <% } %>
    </div>

</section>

<%- include('../partials/footer') %>
