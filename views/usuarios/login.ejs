<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - SIGIF</title>
    <link rel="stylesheet" href="/static/css/style1.css">
</head>
<body class="login-body">

    <div class="login-card">
        <div class="logo-container">
            <img src="/static/img/logologin1.png" alt="Logo SIGIF" class="login-logo" style="width:100%;border-radius: 15%;max-width: 100%;">
        </div>

        <h1>Inicio de sesión</h1>
        <p>Ingrese su correo o nombre de usuario y contraseña</p>

        <form action="/login" method="post">

            <div class="input-group">
                <label for="correo">Correo o Nombre de usuario</label>
                <input type="text" id="correo" name="correo" placeholder="ej: admin@sigif.com o admin" required>
            </div>

            <div class="input-group">
                <label for="clave">Contraseña</label>
                <input type="password" id="clave" name="clave" required>
            </div>

            <button type="submit" class="login-button">
                Ingresar
            </button>
        </form>

        <% if (typeof messages !== 'undefined' && messages.length > 0) { %>
            <div class="messages-container" style="margin-top:16px;">
                <% messages.forEach(function(message){ %>
                    <% const tags = message.tags || message.type || 'info'; %>
                    <div class="alert <%= tags.includes('error') ? 'error' : tags.includes('success') ? 'success' : 'info' %> text-center" style="text-align:center;">
                        <%= message.text || message.message || message %>
                    </div>
                <% }) %>
            </div>
        <% } %>
    </div>

</body>
</html>
