<%- include('../partials/header') %>

<section>
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Usuarios</h1>
    <a href="/usuarios/crear" class="btn btn-success">Agregar usuario</a>
  </div>

  <% if (usuarios && usuarios.length) { %>
    <table class="table">
      <thead>
        <tr>
          <th>Nombre</th>
          <th>Teléfono</th>
          <th>Cargo</th>
          <th>Activo</th>
          <th>Acciones</th>
        </tr>
      </thead>
      <tbody>
        <% usuarios.forEach(function(u){ %>
          <tr>
            <td><%= u.nombre %></td>
            <td><%= u.telefono %></td>
            <td><%= u.cargo %></td>
            <td><%= u.activo ? 'Sí' : 'No' %></td>
            <td>
              <a class="btn btn-sm btn-primary" href="/usuarios/editar/<%= u._id %>">Editar</a>
              <form action="/usuarios/eliminar" method="post" style="display:inline-block;" onsubmit="return confirm('Eliminar usuario?');">
                <input type="hidden" name="id" value="<%= u._id %>" />
                <button class="btn btn-sm btn-danger" type="submit">Eliminar</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } else { %>
    <p>No hay usuarios aún.</p>
  <% } %>
</section>

<%- include('../partials/footer') %>
